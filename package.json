{
  "name": "biblio-rians",
  "version": "0.1.5",
  "description": "Logiciel desktop pour gestion de bibliotheque scolaire",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "sql.js": "^1.10.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.biblio-rians.app",
    "productName": "Biblio-rians",
    "files": [
      "electron-main.js",
      "preload.js",
      "migrations.js",
      "stats.js",
      "data-transfer.js",
      "backup-policy.js",
      "renderer/**/*",
      "node_modules/**/*",
      "!test/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
