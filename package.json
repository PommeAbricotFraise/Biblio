{
  "name": "biblio-rians",
  "version": "0.2.1",
  "description": "Logiciel de gestion de bibliothèque scolaire, simple et hors ligne",
  "author": "PommeAbricotFraise",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:e2e": "node test-e2e/run.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "sql.js": "^1.10.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.biblio-rians.app",
    "productName": "Biblio-rians",
    "artifactName": "Biblio-rians-Installation-${version}.${ext}",
    "files": [
      "electron-main.js",
      "preload.js",
      "migrations.js",
      "stats.js",
      "data-transfer.js",
      "backup-policy.js",
      "renderer/**/*",
      "node_modules/**/*",
      "!test/**/*",
      "!test-e2e/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PommeAbricotFraise",
        "repo": "Biblio"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Biblio-rians",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
